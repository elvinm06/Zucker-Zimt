# Backend API (NestJS uses the global prefix "api")
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Only needed when the app runs in a container: the hostname server-side
# rendering uses to reach the API, since "localhost" there is the container
# itself. Docker Compose sets this automatically.
# INTERNAL_API_URL=http://backend:4000/api

# Branding — consumed by src/config/app.config.ts
NEXT_PUBLIC_APP_NAME=Zucker & Zimt
NEXT_PUBLIC_APP_TAGLINE=Handgemachte Torten — jeder Bissen ein kleines Fest
NEXT_PUBLIC_WHATSAPP_NUMBER=4915112345678
NEXT_PUBLIC_TELEGRAM_USERNAME=zuckerundzimt
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/zuckerundzimt
NEXT_PUBLIC_CONTACT_PHONE=+49 151 1234 5678
NEXT_PUBLIC_ADDRESS=Bäckerstraße 12, 10115 Berlin
NEXT_PUBLIC_OPENING_HOURS=Mo–Sa, 09:00 – 19:00 Uhr
NEXT_PUBLIC_CURRENCY=EUR
NEXT_PUBLIC_LOCALE=de-DE

# Admin panel origin allowed to flush the cache (server-side only)
ADMIN_ORIGIN=http://localhost:3002
