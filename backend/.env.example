# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Origin used to build public URLs for uploaded images
PUBLIC_URL=http://localhost:4000
# API docs at /api/docs — set to false to hide them
SWAGGER_ENABLED=true

# --- Uploads ---
# Cloudinary: persistent, CDN-backed image storage. Set this in production
# (Render's disk is ephemeral — files 404 after every redeploy without it).
# One var is enough; grab it from the Cloudinary dashboard.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Without Cloudinary, uploads go to local disk (fine for dev). On an ephemeral
# host you can instead point this at a mounted persistent volume:
# UPLOADS_DIR=/var/data/uploads

# --- PostgreSQL ---
# Optional: tək connection string. Verilibsə aşağıdakı DB_* dəyişənləri
# nəzərə alınmır (Railway/Render/Heroku bu formatı verir).
# DATABASE_URL=postgres://user:password@host:5432/bakery
# Qeyd: Homebrew ilə quraşdırılan postgres-də "postgres" rolu olmur —
# rol adı macOS istifadəçi adınızdır və şifrə boş qalır (trust auth).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bakery
DB_SYNCHRONIZE=true
# Render/Heroku kimi hostlara XARİCİ bağlantı üçün true olmalıdır.
# Render daxili (internal) hostname istifadə edirsinizsə lazım deyil.
DB_SSL=false

# --- JWT ---
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# --- Seed admin (npm run seed) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
